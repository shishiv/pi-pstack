{
  "name": "@shishiv/pi-pstack",
  "version": "0.1.0",
  "private": true,
  "description": "Verification-first pstack workflows for Pi",
  "keywords": [
    "agent-skills",
    "pi-package",
    "subagents",
    "verification"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "test": "node --test \"test/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:browser": "node test/verification/browser-e2e.mjs",
    "verify:deterministic": "npm run format:check && npm run lint && npm run typecheck && npm test && node scripts/verify-package.mjs --manifest-only",
    "verify:foundation": "npm run typecheck && node --test test/package/*.test.mjs && node scripts/verify-package.mjs --manifest-only && node -e \"console.log('foundation verification passed')\"",
    "verify": "node scripts/verify-all.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "24.12.4",
    "jiti": "2.7.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "pi-mcp-adapter": "2.27.0",
    "pi-subagents": "0.54.0",
    "playwright": "1.62.1",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2",
    "@howaboua/pi-ask": ">=0.0.5",
    "pi-mcp-adapter": ">=2.27.0",
    "pi-subagents": ">=0.54.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "pi-mcp-adapter": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "pi-subagents": {
    "agents": [
      "./agents"
    ]
  }
}
